{
  "name": "000-athena-s-key-to-my-future",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/server.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:prod": "tsc -b && vite build --mode production",
    "deploy:firebase": "npm run build:prod && firebase deploy --only hosting",
    "lint": "oxlint",
    "test:stress": "node server/stress_simulation.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sanity/client": "^8.15.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sanity": "^6.22.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.6",
