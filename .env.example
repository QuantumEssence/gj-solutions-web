# ==============================================================================
# Environment Configuration
# Project: G&J Solutions
# ==============================================================================

# Supabase API Credentials
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY is used by the backend to bypass RLS for administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Admin Authentication & Token Hardening
# ADMIN_PASSWORD is used for administrative gate login (default: EpicTheMusicalAthena)
ADMIN_PASSWORD=EpicTheMusicalAthena
# SESSION_SECRET is used to HMAC-sign time-bounded admin session tokens (recommended: 32+ char random string)
SESSION_SECRET=super-secure-random-hmac-key-for-admin-sessions-32chars
# SESSION_EXPIRY_HOURS defines the validity duration of admin session tokens (default: 8)
SESSION_EXPIRY_HOURS=8

# Rate Limiting & Abuse Defense
# Login brute-force defense
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
# Inquiries submission DoS defense
RATE_LIMIT_INQUIRIES_MAX=30
RATE_LIMIT_INQUIRIES_WINDOW_MS=900000
# Analytics tracking DoS defense
RATE_LIMIT_ANALYTICS_MAX=120
RATE_LIMIT_ANALYTICS_WINDOW_MS=60000

# Analytics Configuration
# Fallback unique visitors count if zero visitor pageviews recorded (0 = authentic real data)
ANALYTICS_FALLBACK_VISITORS=0

# Email Notification Pipeline (Modular Resend / SendGrid / Postmark / Console)
# Supported options: resend | sendgrid | postmark | console
EMAIL_PROVIDER=console
EMAIL_FROM="G&J Solutions <notifications@gjsolutions.com.au>"
ADMIN_ALERT_EMAIL=clinic-admin@gjsolutions.com.au
# RESEND_API_KEY=re_123456789
# SENDGRID_API_KEY=SG.123456789
# POSTMARK_SERVER_TOKEN=your-postmark-server-token

# Server Port (Local dev)
PORT=5000
