rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Inquiries Collection: Public submit, Admin read/manage
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.is_spmc in ['Yes', 'No']
                    && request.resource.data.service_interest is string
                    && request.resource.data.schedule_meeting is string;
      
      allow read, update, delete: if request.auth != null;
    }

    // Page Views Collection: Public anonymous tracking, Admin read
    match /page_views/{viewId} {
      allow create: if request.resource.data.path is string;
      allow read, delete: if request.auth != null;
    }

    // Site Content CMS: Public read, Admin write
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
